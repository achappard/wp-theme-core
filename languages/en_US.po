msgstr "You are not allowed to upload SVG files."

#: Features/Admin/SvgSupport.php:164
msgid "Le fichier SVG n’a pas pu être lu."
msgstr "The SVG file could not be read."

#: Features/Admin/SvgSupport.php:172
msgid "Ce fichier SVG a été refusé : il est invalide ou contient du code non autorisé."
msgstr "This SVG file was rejected: it is invalid or contains unauthorized code."

#: Features/Admin/SvgSupport.php:178
msgid "Le fichier SVG n’a pas pu être nettoyé avant son enregistrement."
msgstr "The SVG file could not be cleaned up before it was saved."

